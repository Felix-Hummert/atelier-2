# The disposable #301-A Runner image. Its provider toolchain lives in the
# read-only image root; every writable surface the launcher mounts is a
# `noexec,nosuid` tmpfs, so nothing this container may write it may run.
#
# CLAUDE_VERSION carries no default on purpose: the launcher reads it out of
# `CONFORMANT_CLAUDE_VERSIONS`, which is the one register of that fact, and a
# build that forgets to pass it must fail rather than pick a release nobody
# measured. The runner re-measures `claude --version` against that same set
# before every provider start anyway, so this argument is a build convenience
# and never the trusted pin.
ARG CLAUDE_VERSION

FROM node:22-bookworm-slim AS claude-toolchain
ARG CLAUDE_VERSION
RUN test -n "${CLAUDE_VERSION}" \
    && npm install --no-fund --no-audit --global --prefix /opt/claude \
    "@anthropic-ai/claude-code@${CLAUDE_VERSION}"

# The launcher's network-policy container: it joins the started Runner's own
# network namespace, installs that Attempt's egress rules, and exits. It is
# never the Runner image, so no packet-filtering tool ever sits beside the
# provider CLI.
FROM debian:bookworm-slim AS network-policy
RUN apt-get update \
    && apt-get install --yes --no-install-recommends iptables iproute2 \
    && rm -rf /var/lib/apt/lists/*

FROM python:3.12-slim AS runner
# bubblewrap is what the Claude CLI itself requires to start once this
# executor asks it to scrub every subprocess environment; libstdc++6 is what
# the copied node binary links against.
RUN apt-get update \
    && apt-get install --yes --no-install-recommends bubblewrap libstdc++6 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=claude-toolchain /usr/local/bin/node /usr/local/bin/node
COPY --from=claude-toolchain /opt/claude /opt/claude
ENV PATH="/opt/claude/bin:${PATH}"
WORKDIR /work
COPY pyproject.toml uv.lock ./
COPY src ./src
RUN pip install --no-cache-dir .
USER 10001:10001
ENTRYPOINT ["atelier2-runner", "--candidate-handoff", "/handoff", "--candidate-identity", "/run/atelier2-identity", "--candidate-journal", "/journal", "--candidate-invocation-offer", "/offer/invocation.json"]
