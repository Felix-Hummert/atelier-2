{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidate_digest", "verdict_digest", "verdict"],
  "properties": {
    "candidate_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "verdict_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "verdict": {"enum": ["approve", "revise", "cannot-judge"]}
  }
}
