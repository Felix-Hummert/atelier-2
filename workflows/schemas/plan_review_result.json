{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["risks", "plan", "verdict"],
  "properties": {
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text"],
        "properties": {
          "text": {"type": "string"}
        }
      }
    },
    "plan": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step", "files", "test"],
        "properties": {
          "step": {"type": "string"},
          "files": {
            "type": "array",
            "items": {"type": "string"}
          },
          "test": {"type": "string"}
        }
      }
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "verdict": {
      "enum": ["pass", "revise", "cannot-judge"]
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "required": ["verdict"],
        "properties": {
          "verdict": {"const": "revise"}
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "risks": {"type": "array", "minItems": 1}
        }
      }
    },
    {
      "if": {
        "type": "object",
        "required": ["verdict"],
        "properties": {
          "verdict": {"const": "cannot-judge"}
        }
      },
      "then": {
        "type": "object",
        "required": ["reason"]
      }
    }
  ]
}
