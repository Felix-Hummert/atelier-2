{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mirror",
    "expectation",
    "verdict"
  ],
  "properties": {
    "mirror": {
      "type": "string",
      "pattern": "^(?=[\\s\\S]*\\b[Ss]o habe ich dich verstanden\\b)[^.!?]+[.!?]\\s+[^.!?]+[.!?]$"
    },
    "expectation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lens",
        "sentence",
        "example",
        "counterexample",
        "technical",
        "default",
        "status"
      ],
      "properties": {
        "lens": {
          "enum": [
            "create_change_remove",
            "identity",
          "states",
          "secrets_and_rights",
          "undo",
            "scale"
          ]
        },
        "sentence": {"type": "string"},
        "example": {"type": "string", "pattern": "^Wenn du .+, dann .+[.!?]$"},
        "counterexample": {
          "type": "string",
          "pattern": "^Sagst du nein, dann .+[.!?]$"
        },
        "technical": {"type": "string"},
        "default": {"enum": ["yes", "no", "later"]},
        "status": {"enum": ["proposed"]}
      }
    },
    "verdict": {"enum": ["complete", "needs_more"]}
  }
}
